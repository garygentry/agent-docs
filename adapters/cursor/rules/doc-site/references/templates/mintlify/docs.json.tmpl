{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "{{MINT_THEME}}",
  "name": "{{SITE_TITLE}}",
  "description": "{{SITE_DESC}}",
  "colors": {
    "primary": "{{MINT_PRIMARY}}",
    "light": "{{MINT_COLOR_LIGHT}}",
    "dark": "{{MINT_COLOR_DARK}}"
  },
  "favicon": "/favicon.svg",
  "navigation": {{MINT_NAVIGATION}},
  // NOTE: `docs.json` is GENERATED by src/mintlify/emit.ts (buildDocsJson), which is
  // authoritative — this template is the reference shape. The navbar + footer below are
  // emitted ONLY when {{GITHUB_URL}} is non-empty; with no GitHub URL they are OMITTED
  // entirely (never emitted with an empty href). Mintlify's docs.json is JSONC, so this
  // comment is valid in the real file too.
  "navbar": {
    "links": [{ "label": "GitHub", "href": "{{GITHUB_URL}}" }]
  },
  "footer": {
    "socials": { "github": "{{GITHUB_URL}}" }
  }
}
